# ベースイメージ
FROM python:3.11-slim

# 作業ディレクトリ設定
WORKDIR /app

# 依存パッケージをコピー
COPY backend/requirements.txt .

# 依存パッケージをインストール
RUN pip install --no-cache-dir -r requirements.txt

# アプリケーションコードをコピー
COPY backend/ .

# ポート 8080 を公開
EXPOSE 8080

# アプリケーション実行コマンド
CMD exec gunicorn --bind :8080 --workers 1 --threads 8 --timeout 0 app:app
